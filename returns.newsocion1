local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local TextService = game:GetService("TextService")
local Players = game:GetService("Players")

local NeoUI = {}

local ICONS = {
	Home = "rbxassetid://6031075938",
	Settings = "rbxassetid://6031280883",
	Search = "rbxassetid://6031154871",
	Shield = "rbxassetid://6031082533",
	Server = "rbxassetid://6031086212",
	Users = "rbxassetid://6031265976",
	Chart = "rbxassetid://6031091004",
	Bolt = "rbxassetid://6031225816",
	Info = "rbxassetid://6031280883",
	Close = "rbxassetid://6031094678",
	Menu = "rbxassetid://6031280883",
	Chevron = "rbxassetid://6031090990"
}

local THEMES = {
	Midnight = {
		Window = Color3.fromRGB(13, 16, 23),
		Panel = Color3.fromRGB(20, 24, 33),
		Surface = Color3.fromRGB(27, 32, 43),
		SurfaceHover = Color3.fromRGB(36, 43, 57),
		Stroke = Color3.fromRGB(52, 61, 78),
		Text = Color3.fromRGB(239, 243, 250),
		Muted = Color3.fromRGB(151, 161, 178),
		Accent = Color3.fromRGB(91, 145, 255),
		AccentSoft = Color3.fromRGB(35, 61, 111),
		Danger = Color3.fromRGB(235, 92, 106)
	},
	Obsidian = {
		Window = Color3.fromRGB(8, 8, 11),
		Panel = Color3.fromRGB(15, 15, 20),
		Surface = Color3.fromRGB(24, 24, 31),
		SurfaceHover = Color3.fromRGB(35, 35, 44),
		Stroke = Color3.fromRGB(52, 52, 63),
		Text = Color3.fromRGB(247, 247, 250),
		Muted = Color3.fromRGB(157, 157, 171),
		Accent = Color3.fromRGB(173, 120, 255),
		AccentSoft = Color3.fromRGB(66, 40, 106),
		Danger = Color3.fromRGB(238, 96, 117)
	},
	Arctic = {
		Window = Color3.fromRGB(235, 241, 249),
		Panel = Color3.fromRGB(249, 251, 255),
		Surface = Color3.fromRGB(222, 231, 243),
		SurfaceHover = Color3.fromRGB(205, 218, 236),
		Stroke = Color3.fromRGB(183, 198, 219),
		Text = Color3.fromRGB(22, 31, 45),
		Muted = Color3.fromRGB(83, 101, 126),
		Accent = Color3.fromRGB(35, 111, 218),
		AccentSoft = Color3.fromRGB(184, 211, 247),
		Danger = Color3.fromRGB(205, 55, 72)
	},
	Aurora = {
		Window = Color3.fromRGB(16, 24, 31),
		Panel = Color3.fromRGB(22, 34, 43),
		Surface = Color3.fromRGB(29, 48, 55),
		SurfaceHover = Color3.fromRGB(39, 67, 72),
		Stroke = Color3.fromRGB(52, 86, 91),
		Text = Color3.fromRGB(236, 252, 246),
		Muted = Color3.fromRGB(150, 190, 181),
		Accent = Color3.fromRGB(55, 216, 171),
		AccentSoft = Color3.fromRGB(27, 90, 80),
		Danger = Color3.fromRGB(239, 102, 119)
	}
}

local function tween(object, properties, duration)
	if object and object.Parent then
		TweenService:Create(
			object,
			TweenInfo.new(
				duration or 0.2,
				Enum.EasingStyle.Quint,
				Enum.EasingDirection.Out
			),
			properties
		):Play()
	end
end

local function corner(parent, radius)
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, radius or 8)
	c.Parent = parent
	return c
end

local function stroke(parent, color, thickness)
	local s = Instance.new("UIStroke")
	s.Color = color
	s.Thickness = thickness or 1
	s.Transparency = 0.12
	s.Parent = parent
	return s
end

local function label(parent, text, size, color, font)
	local l = Instance.new("TextLabel")
	l.BackgroundTransparency = 1
	l.Text = text or ""
	l.TextSize = size or 13
	l.TextColor3 = color or Color3.new(1, 1, 1)
	l.Font = font or Enum.Font.Gotham
	l.TextXAlignment = Enum.TextXAlignment.Left
	l.Parent = parent
	return l
end

local function resolveIcon(icon)
	if typeof(icon) == "number" then
		return "rbxassetid://" .. tostring(icon)
	end

	if typeof(icon) == "string" then
		if string.find(icon, "rbxassetid://") then
			return icon
		end

		return ICONS[icon] or icon
	end

	return ICONS.Info
end

local function makeDraggable(handle, target)
	local active = false
	local origin = nil
	local start = nil

	handle.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then

			active = true
			origin = input.Position
			start = target.Position

			input.Changed:Connect(function()
				if input.UserInputState == Enum.UserInputState.End then
					active = false
				end
			end)
		end
	end)

	UserInputService.InputChanged:Connect(function(input)
		if active
			and (
				input.UserInputType == Enum.UserInputType.MouseMovement
				or input.UserInputType == Enum.UserInputType.Touch
			) then

			local delta = input.Position - origin

			target.Position = UDim2.new(
				start.X.Scale,
				start.X.Offset + delta.X,
				start.Y.Scale,
				start.Y.Offset + delta.Y
			)
		end
	end)
end

function NeoUI.Create(config)
	config = config or {}

	local player = Players.LocalPlayer
	local parent = config.Parent
		or (player and player:WaitForChild("PlayerGui"))
		or game:GetService("CoreGui")

	local themeName = THEMES[config.Theme] and config.Theme or "Midnight"
	local t = THEMES[themeName]

	local title = config.Title or "NEO INTERFACE"
	local subtitle = config.Subtitle or "Advanced control center"
	local windowName = config.Name or "NeoUIWindow"

	local gui = Instance.new("ScreenGui")
	gui.Name = windowName
	gui.IgnoreGuiInset = true
	gui.ResetOnSpawn = false
	gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	gui.Parent = parent

	local restore = Instance.new("TextButton")
	restore.Name = "RestoreButton"
	restore.AnchorPoint = Vector2.new(0, 1)
	restore.Position = UDim2.new(0, 18, 1, -18)
	restore.Size = UDim2.fromOffset(48, 48)
	restore.BackgroundColor3 = t.Panel
	restore.Text = ""
	restore.Visible = false
	restore.Parent = gui

	corner(restore, 16)
	stroke(restore, t.Stroke, 1)

	local restoreIcon = Instance.new("ImageLabel")
	restoreIcon.BackgroundTransparency = 1
	restoreIcon.Size = UDim2.fromOffset(22, 22)
	restoreIcon.Position = UDim2.fromScale(0.5, 0.5)
	restoreIcon.AnchorPoint = Vector2.new(0.5, 0.5)
	restoreIcon.Image = resolveIcon(config.RestoreIcon or "Menu")
	restoreIcon.ImageColor3 = t.Text
	restoreIcon.Parent = restore

	local window = Instance.new("Frame")
	window.Name = "Window"
	window.AnchorPoint = Vector2.new(0.5, 0.5)
	window.Position = UDim2.fromScale(0.5, 0.5)
	window.Size = UDim2.fromOffset(
		config.Width or 650,
		config.Height or 410
	)
	window.BackgroundColor3 = t.Window
	window.Parent = gui

	corner(window, 14)

	local windowStroke = stroke(window, t.Stroke, 1)

	local top = Instance.new("Frame")
	top.Name = "Header"
	top.Size = UDim2.new(1, 0, 0, 64)
	top.BackgroundColor3 = t.Panel
	top.Parent = window

	corner(top, 14)
	makeDraggable(top, window)

	local accent = Instance.new("Frame")
	accent.Size = UDim2.fromOffset(4, 32)
	accent.Position = UDim2.new(0, 14, 0.5, -16)
	accent.BackgroundColor3 = t.Accent
	accent.Parent = top

	corner(accent, 3)

	local titleLabel = label(
		top,
		string.upper(title),
		14,
		t.Text,
		Enum.Font.GothamBold
	)

	titleLabel.Position = UDim2.new(0, 30, 0, 12)
	titleLabel.Size = UDim2.new(1, -150, 0, 20)

	local subtitleLabel = label(
		top,
		subtitle,
		11,
		t.Muted,
		Enum.Font.Gotham
	)

	subtitleLabel.Position = UDim2.new(0, 30, 0, 33)
	subtitleLabel.Size = UDim2.new(1, -150, 0, 18)

	local hideButton = Instance.new("ImageButton")
	hideButton.Name = "HideButton"
	hideButton.Size = UDim2.fromOffset(30, 30)
	hideButton.Position = UDim2.new(1, -78, 0.5, -15)
	hideButton.BackgroundColor3 = t.Surface
	hideButton.Image = resolveIcon(config.HideIcon or "Chevron")
	hideButton.ImageColor3 = t.Muted
	hideButton.Parent = top

	corner(hideButton, 8)

	local closeButton = Instance.new("ImageButton")
	closeButton.Name = "CloseButton"
	closeButton.Size = UDim2.fromOffset(30, 30)
	closeButton.Position = UDim2.new(1, -42, 0.5, -15)
	closeButton.BackgroundColor3 = t.Surface
	closeButton.Image = resolveIcon(config.CloseIcon or "Close")
	closeButton.ImageColor3 = t.Muted
	closeButton.Parent = top

	corner(closeButton, 8)

	local body = Instance.new("Frame")
	body.Name = "Body"
	body.Position = UDim2.new(0, 0, 0, 64)
	body.Size = UDim2.new(1, 0, 1, -64)
	body.BackgroundTransparency = 1
	body.Parent = window

	local rail = Instance.new("ScrollingFrame")
	rail.Name = "Navigation"
	rail.Position = UDim2.fromOffset(12, 12)
	rail.Size = UDim2.new(0, 150, 1, -24)
	rail.BackgroundColor3 = t.Panel
	rail.BorderSizePixel = 0
	rail.ScrollBarThickness = 2
	rail.CanvasSize = UDim2.new()
	rail.Parent = body

	corner(rail, 10)
	stroke(rail, t.Stroke, 1)

	local railLayout = Instance.new("UIListLayout")
	railLayout.Padding = UDim.new(0, 6)
	railLayout.SortOrder = Enum.SortOrder.LayoutOrder
	railLayout.Parent = rail

	local railPadding = Instance.new("UIPadding")
	railPadding.PaddingTop = UDim.new(0, 10)
	railPadding.PaddingLeft = UDim.new(0, 8)
	railPadding.PaddingRight = UDim.new(0, 8)
	railPadding.PaddingBottom = UDim.new(0, 10)
	railPadding.Parent = rail

	local content = Instance.new("Frame")
	content.Name = "Content"
	content.Position = UDim2.new(0, 174, 0, 12)
	content.Size = UDim2.new(1, -186, 1, -24)
	content.BackgroundColor3 = t.Panel
	content.Parent = body

	corner(content, 10)
	stroke(content, t.Stroke, 1)

	local pages = {}
	local navItems = {}
	local activePage = nil
	local destroyed = false
	local collapsed = false
	local mobile = false

	local function applyTheme()
		for _, item in ipairs(gui:GetDescendants()) do
			local role = item:GetAttribute("NeoRole")

			if role and t[role] then
				if item:IsA("GuiObject") then
					item.BackgroundColor3 = t[role]
				end

				if item:IsA("TextLabel")
					or item:IsA("TextButton")
					or item:IsA("TextBox") then
					item.TextColor3 = t[role]
				end

				if item:IsA("ImageLabel")
					or item:IsA("ImageButton") then
					item.ImageColor3 = t[role]
				end

				if item:IsA("UIStroke") then
					item.Color = t[role]
				end
			end
		end

		window.BackgroundColor3 = t.Window
		windowStroke.Color = t.Stroke
	end

	local function role(item, name)
		item:SetAttribute("NeoRole", name)
		return item
	end

	local function setActive(pageName)
		for name, page in pairs(pages) do
			page.Visible = name == pageName

			local n = navItems[name]

			if n then
				n.Button.BackgroundTransparency = name == pageName and 0 or 1
				n.Icon.ImageColor3 = name == pageName and t.Text or t.Muted
				n.Label.TextColor3 = name == pageName and t.Text or t.Muted
			end
		end

		activePage = pageName
	end

	local function updateResponsive()
		local width = window.AbsoluteSize.X
		mobile = width < (config.MobileBreakpoint or 540)

		if mobile then
			rail.Position = UDim2.fromOffset(8, 8)
			rail.Size = UDim2.new(0, 54, 1, -16)

			content.Position = UDim2.new(0, 70, 0, 8)
			content.Size = UDim2.new(1, -78, 1, -16)

			for _, n in pairs(navItems) do
				n.Label.Visible = false
			end
		else
			rail.Position = UDim2.fromOffset(12, 12)
			rail.Size = UDim2.new(0, 150, 1, -24)

			content.Position = UDim2.new(0, 174, 0, 12)
			content.Size = UDim2.new(1, -186, 1, -24)

			for _, n in pairs(navItems) do
				n.Label.Visible = true
			end
		end
	end

	window:GetPropertyChangedSignal("AbsoluteSize"):Connect(updateResponsive)

	local api = {}

	function api:CreateTab(name, icon)
		assert(
			type(name) == "string" and name ~= "",
			"Tab name is required"
		)

		local page = Instance.new("ScrollingFrame")
		page.Name = name .. "Page"
		page.Size = UDim2.new(1, -20, 1, -20)
		page.Position = UDim2.fromOffset(10, 10)
		page.BackgroundTransparency = 1
		page.BorderSizePixel = 0
		page.ScrollBarThickness = 3
		page.Visible = false
		page.Parent = content

		local layout = Instance.new("UIListLayout")
		layout.Padding = UDim.new(0, 8)
		layout.Parent = page

		local padding = Instance.new("UIPadding")
		padding.PaddingBottom = UDim.new(0, 12)
		padding.Parent = page

		layout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
			page.CanvasSize = UDim2.fromOffset(
				0,
				layout.AbsoluteContentSize.Y + 20
			)
		end)

		local nav = Instance.new("TextButton")
		nav.Name = name .. "Nav"
		nav.Size = UDim2.new(1, 0, 0, 40)
		nav.BackgroundColor3 = t.Surface
		nav.BackgroundTransparency = 1
		nav.Text = ""
		nav.LayoutOrder = #navItems + 1
		nav.Parent = rail

		corner(nav, 8)

		local navIcon = Instance.new("ImageLabel")
		navIcon.BackgroundTransparency = 1
		navIcon.Size = UDim2.fromOffset(18, 18)
		navIcon.Position = UDim2.new(0, 12, 0.5, -9)
		navIcon.Image = resolveIcon(icon or "Info")
		navIcon.ImageColor3 = t.Muted
		navIcon.Parent = nav

		local navLabel = label(
			nav,
			name,
			12,
			t.Muted,
			Enum.Font.GothamMedium
		)

		navLabel.Position = UDim2.new(0, 38, 0, 0)
		navLabel.Size = UDim2.new(1, -44, 1, 0)

		nav.MouseButton1Click:Connect(function()
			setActive(name)
		end)

		pages[name] = page
		navItems[name] = {
			Button = nav,
			Icon = navIcon,
			Label = navLabel
		}

		if not activePage then
			setActive(name)
		end

		local tab = {}

		local function card(height)
			local f = Instance.new("Frame")
			f.Size = UDim2.new(1, 0, 0, height or 42)
			f.BackgroundColor3 = t.Surface
			f.Parent = page

			corner(f, 9)

			return f
		end

		local function text(parent, value, roleName)
			local l = label(
				parent,
				value,
				12,
				t[roleName or "Text"],
				Enum.Font.Gotham
			)

			role(l, roleName or "Text")

			return l
		end

		function tab:AddLabel(value)
			local f = card(34)

			local l = text(f, value, "Muted")
			l.Position = UDim2.new(0, 12, 0, 0)
			l.Size = UDim2.new(1, -24, 1, 0)

			return f
		end

		function tab:AddButton(value, callback)
			local b = Instance.new("TextButton")
			b.Size = UDim2.new(1, 0, 0, 42)
			b.BackgroundColor3 = t.Accent
			b.Text = value
			b.TextColor3 = t.Text
			b.Font = Enum.Font.GothamBold
			b.TextSize = 12
			b.Parent = page

			corner(b, 9)

			b.MouseButton1Click:Connect(function()
				if callback then
					callback()
				end
			end)

			return b
		end

		function tab:AddToggle(value, default, callback)
			if type(default) == "function" then
				callback = default
				default = false
			end

			local f = card(46)

			local l = text(f, value)
			l.Position = UDim2.new(0, 12, 0, 0)
			l.Size = UDim2.new(1, -76, 1, 0)

			local b = Instance.new("TextButton")
			b.Size = UDim2.fromOffset(44, 24)
			b.Position = UDim2.new(1, -56, 0.5, -12)
			b.BackgroundColor3 = t.Panel
			b.Text = ""
			b.Parent = f

			corner(b, 12)

			local dot = Instance.new("Frame")
			dot.Size = UDim2.fromOffset(18, 18)
			dot.Position = UDim2.new(0, 3, 0.5, -9)
			dot.BackgroundColor3 = t.Muted
			dot.Parent = b

			corner(dot, 9)

			local state = default == true

			local function render(fire)
				tween(
					b,
					{
						BackgroundColor3 = state and t.AccentSoft or t.Panel
					},
					0.15
				)

				tween(
					dot,
					{
						Position = state
							and UDim2.new(1, -21, 0.5, -9)
							or UDim2.new(0, 3, 0.5, -9),
						BackgroundColor3 = state and t.Accent or t.Muted
					},
					0.15
				)

				if fire and callback then
					callback(state)
				end
			end

			b.MouseButton1Click:Connect(function()
				state = not state
				render(true)
			end)

			render(false)

			return {
				Frame = f,
				Get = function()
					return state
				end,
				Set = function(_, v)
					state = v == true
					render(false)
				end
			}
		end

		function tab:AddInput(value, placeholder, callback)
			local f = card(46)

			local l = text(f, value)
			l.Position = UDim2.new(0, 12, 0, 0)
			l.Size = UDim2.new(0.42, -10, 1, 0)

			local box = Instance.new("TextBox")
			box.Size = UDim2.new(0.53, 0, 0, 30)
			box.Position = UDim2.new(0.45, 0, 0.5, -15)
			box.BackgroundColor3 = t.Panel
			box.TextColor3 = t.Text
			box.PlaceholderColor3 = t.Muted
			box.PlaceholderText = placeholder or "Enter value"
			box.Text = ""
			box.TextSize = 12
			box.Font = Enum.Font.Gotham
			box.ClearTextOnFocus = false
			box.Parent = f

			corner(box, 7)

			box.FocusLost:Connect(function(enter)
				if callback then
					callback(box.Text, enter)
				end
			end)

			return box
		end

		function tab:AddSlider(value, min, max, default, callback)
			min = min or 0
			max = max or 100
			default = default == nil and min or default

			if max <= min then
				max = min + 1
			end

			local f = card(66)

			local l = text(f, value)
			l.Position = UDim2.fromOffset(12, 7)
			l.Size = UDim2.new(0.7, 0, 0, 20)

			local readout = text(
				f,
				tostring(default),
				"Accent"
			)

			readout.Position = UDim2.new(1, -70, 0, 7)
			readout.Size = UDim2.fromOffset(58, 20)
			readout.TextXAlignment = Enum.TextXAlignment.Right

			local bar = Instance.new("Frame")
			bar.Size = UDim2.new(1, -24, 0, 6)
			bar.Position = UDim2.fromOffset(12, 43)
			bar.BackgroundColor3 = t.Panel
			bar.Parent = f

			corner(bar, 3)

			local fill = Instance.new("Frame")
			fill.BackgroundColor3 = t.Accent
			fill.Size = UDim2.new(0, 0, 1, 0)
			fill.Parent = bar

			corner(fill, 3)

			local button = Instance.new("TextButton")
			button.BackgroundTransparency = 1
			button.Text = ""
			button.Size = UDim2.new(1, 20, 0, 28)
			button.Position = UDim2.new(0, -10, 0.5, -14)
			button.Parent = bar

			local dragging = false

			local function update(x, fire)
				local p = math.clamp(
					(x - bar.AbsolutePosition.X) / bar.AbsoluteSize.X,
					0,
					1
				)

				local result = math.floor(
					min + (max - min) * p + 0.5
				)

				fill.Size = UDim2.new(p, 0, 1, 0)
				readout.Text = tostring(result)

				if fire and callback then
					callback(result)
				end
			end

			button.InputBegan:Connect(function(input)
				if input.UserInputType == Enum.UserInputType.MouseButton1
					or input.UserInputType == Enum.UserInputType.Touch then

					dragging = true
					update(input.Position.X, true)
				end
			end)

			UserInputService.InputChanged:Connect(function(input)
				if dragging
					and (
						input.UserInputType == Enum.UserInputType.MouseMovement
						or input.UserInputType == Enum.UserInputType.Touch
					) then

					update(input.Position.X, true)
				end
			end)

			UserInputService.InputEnded:Connect(function(input)
				if input.UserInputType == Enum.UserInputType.MouseButton1
					or input.UserInputType == Enum.UserInputType.Touch then

					dragging = false
				end
			end)

			update(
				bar.AbsolutePosition.X
					+ bar.AbsoluteSize.X
					* math.clamp((default - min) / (max - min), 0, 1),
				false
			)

			return f
		end

		function tab:AddDropdown(value, options, callback)
			local f = card(44)

			local b = Instance.new("TextButton")
			b.Size = UDim2.new(1, -16, 0, 30)
			b.Position = UDim2.fromOffset(8, 7)
			b.BackgroundColor3 = t.Panel
			b.Text = value .. "  •  Select"
			b.TextColor3 = t.Text
			b.TextSize = 12
			b.Font = Enum.Font.Gotham
			b.TextXAlignment = Enum.TextXAlignment.Left
			b.Parent = f

			corner(b, 7)

			local open = false

			local list = Instance.new("Frame")
			list.BackgroundColor3 = t.Panel
			list.Position = UDim2.new(0, 0, 1, 4)
			list.Size = UDim2.new(1, 0, 0, 0)
			list.ClipsDescendants = true
			list.Visible = false
			list.ZIndex = 10
			list.Parent = f

			corner(list, 7)

			local ll = Instance.new("UIListLayout")
			ll.Padding = UDim.new(0, 3)
			ll.Parent = list

			for _, option in ipairs(options or {}) do
				local item = Instance.new("TextButton")
				item.Size = UDim2.new(1, -8, 0, 28)
				item.BackgroundColor3 = t.Surface
				item.Text = tostring(option)
				item.TextColor3 = t.Text
				item.TextSize = 11
				item.Font = Enum.Font.Gotham
				item.Parent = list

				corner(item, 5)

				item.MouseButton1Click:Connect(function()
					b.Text = value .. "  •  " .. tostring(option)
					open = false
					list.Visible = false

					tween(
						list,
						{
							Size = UDim2.new(1, 0, 0, 0)
						},
						0.16
					)

					f.Size = UDim2.new(1, 0, 0, 44)

					if callback then
						callback(option)
					end
				end)
			end

			b.MouseButton1Click:Connect(function()
				open = not open

				if open then
					list.Visible = true
					list.Size = UDim2.new(1, 0, 0, 0)

					local h = math.min(
						28 * #(options or {}) + 8,
						150
					)

					tween(
						list,
						{
							Size = UDim2.new(1, 0, 0, h)
						},
						0.18
					)

					f.Size = UDim2.new(
						1,
						0,
						0,
						44 + h + 4
					)
				else
					tween(
						list,
						{
							Size = UDim2.new(1, 0, 0, 0)
						},
						0.18
					)

					task.delay(0.18, function()
						if not open then
							list.Visible = false
						end
					end)

					f.Size = UDim2.new(1, 0, 0, 44)
				end
			end)

			return f
		end

		function tab:AddSearch(value, items, callback)
			local f = card(44)

			local box = Instance.new("TextBox")
			box.Size = UDim2.new(1, -16, 0, 30)
			box.Position = UDim2.fromOffset(8, 7)
			box.BackgroundColor3 = t.Panel
			box.PlaceholderText = value or "Search"
			box.Text = ""
			box.TextColor3 = t.Text
			box.PlaceholderColor3 = t.Muted
			box.Font = Enum.Font.Gotham
			box.TextSize = 12
			box.Parent = f

			corner(box, 7)

			box:GetPropertyChangedSignal("Text"):Connect(function()
				local q = string.lower(box.Text)

				for _, item in ipairs(items or {}) do
					if string.find(
						string.lower(tostring(item)),
						q,
						1,
						true
					) and callback then
						callback(item)
					end
				end
			end)

			return box
		end

		return tab
	end

	function api:SetTheme(name)
		if THEMES[name] then
			themeName = name
			t = THEMES[name]
			applyTheme()
			return true
		end

		return false
	end

	function api:GetTheme()
		return themeName
	end

	function api:GetIcons()
		return table.clone(ICONS)
	end

	function api:Hide()
		if destroyed then
			return
		end

		window.Visible = false
		restore.Visible = true
	end

	function api:Show()
		if destroyed then
			return
		end

		restore.Visible = false
		window.Visible = true
	end

	function api:Toggle()
		if window.Visible then
			self:Hide()
		else
			self:Show()
		end
	end

	function api:Destroy()
		if not destroyed then
			destroyed = true
			gui:Destroy()
		end
	end

	function api:SetCollapsed(value)
		collapsed = value == true
		body.Visible = not collapsed

		tween(
			window,
			{
				Size = collapsed
					and UDim2.fromOffset(
						math.min(window.AbsoluteSize.X, 430),
						64
					)
					or UDim2.fromOffset(
						config.Width or 650,
						config.Height or 410
					)
			},
			0.22
		)
	end

	function api:IsMobile()
		return mobile
	end

	restore.MouseButton1Click:Connect(function()
		api:Show()
	end)

	hideButton.MouseButton1Click:Connect(function()
		api:Hide()
	end)

	closeButton.MouseButton1Click:Connect(function()
		api:Destroy()
	end)

	applyTheme()
	updateResponsive()

	if config.Hidden then
		api:Hide()
	end

	return api
end

NeoUI.Icons = table.clone(ICONS)
NeoUI.Themes = table.clone(THEMES)

return NeoUI
